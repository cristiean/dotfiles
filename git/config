# Global git config. Git reads ~/.config/git/config automatically.
# ~/.gitconfig, if present, is read after this file and wins, so use it for
# per-machine overrides (e.g. a work email) without touching this repo.

[user]
    name = Alexandru Cristiean
    email = alexandru@cristiean.com

[init]
    defaultBranch = main

[push]
    autoSetupRemote = true      # first `git push` on a new branch sets upstream

[fetch]
    prune = true                # drop remote branches deleted on the server

[pull]
    rebase = true               # `git pull` replays local commits on top of the remote's

[merge]
    conflictStyle = zdiff3      # conflict markers also show the common ancestor's version

[rerere]
    enabled = true              # record how a conflict was resolved; reuse it if it recurs

[branch]
    sort = -committerdate       # `git branch` lists the branch with the latest commit first

[color "status"]
    added = green bold
    changed = red bold
    untracked = magenta bold
    branch = blue bold ul

# Per-directory identity, e.g. a work email for everything under ~/Dev/work:
# [includeIf "gitdir:~/Dev/work/"]
#     path = ~/.config/git/work
