<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.cristiean.bluetoothbar</string>
	<key>CFBundleName</key>
	<string>BluetoothBar</string>
	<key>CFBundleExecutable</key>
	<string>BluetoothBar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- Menu bar only: no Dock icon or app menu -->
	<key>LSUIElement</key>
	<true/>
	<!-- Without this, macOS silently blocks Bluetooth (what broke SwiftBar) -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>BluetoothBar shows whether your AirPods and keyboard are connected, and connects or pairs them when you click.</string>
</dict>
</plist>
