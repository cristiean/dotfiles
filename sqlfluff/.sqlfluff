# SQLFluff settings for every project on this Mac. SQLFluff reads
# ~/.config/sqlfluff/.sqlfluff first and a project's own config after it, so a
# project's settings override the ones here.
#
# The layout settings give compact queries. A list of columns, a short
# statement and a short subquery each stay on one line while they fit.

[sqlfluff]
# The dialect for SQL in a folder that sets none. SQLFluff cannot detect the
# dialect, and stops with an error when none is set.
dialect = clickhouse

# The longest line that SQLFluff accepts. It breaks a longer line.
max_line_length = 160

# Rules that are off:
# - capitalisation.identifiers, capitalisation.functions, capitalisation.types:
#   names of columns, functions and data types keep their case. ClickHouse
#   names are case-sensitive, so a query with a changed name fails.
# - layout.select_targets puts every column of a SELECT on its own line.
# - layout.cte_newline adds a blank line after every CTE.
# - convention.terminator moves the semicolon. It stays where you put it.
exclude_rules = capitalisation.identifiers, capitalisation.functions, capitalisation.types, layout.select_targets, layout.cte_newline, convention.terminator

[sqlfluff:indentation]
# WITH stands on its own line, and each CTE is indented below it. Then
# bin/sqlfluff-compact puts the first CTE on the line of WITH and lines the
# next ones up under it.
indented_ctes = True
# The first condition follows WHERE on the same line. A line that starts with
# AND or OR is indented below it by 4, which bin/sqlfluff-compact makes 2.
implicit_indents = require
# SQLFluff leaves the indentation inside ALTER TABLE as you wrote it. Without
# this, it moves the ADD COLUMN lines back to the left margin.
skip_indentation_in = script_content, alter_table_statement

# Upper case for keywords (SELECT) and for NULL, TRUE and FALSE.
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper
# SQLFluff reads the ClickHouse type Tuple as a keyword. Type names are
# case-sensitive in ClickHouse, so Tuple keeps its case.
ignore_words = tuple

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

# A comment may be longer than max_line_length.
[sqlfluff:rules:layout.long_lines]
ignore_comment_lines = True

# No space between the two brackets of a ClickHouse aggregate function that
# takes parameters, such as quantile(0.9)(x).
[sqlfluff:layout:type:function_contents]
spacing_before = touch:inline
spacing_within = touch:inline

# The data types of a column list line up in one column:
#     id        UInt32,
#     long_name Nullable(String),
# The setting applies inside one pair of brackets. The types inside a type,
# such as String in Nullable(String), stay where they are.
[sqlfluff:layout:type:data_type]
spacing_before = align
align_within = bracketed
align_scope = bracketed_arguments

# A clause may share a line with the clause before it, as in
#     SELECT * FROM t WHERE x = 1;
# SQLFluff starts a new line for a clause only where you started one, or to
# break a line that is longer than max_line_length. By default it always puts
# these four keywords at the start of a line.
[sqlfluff:layout:type:where_clause]
keyword_line_position = none

[sqlfluff:layout:type:groupby_clause]
keyword_line_position = none

[sqlfluff:layout:type:having_clause]
keyword_line_position = none

[sqlfluff:layout:type:orderby_clause]
keyword_line_position = none
