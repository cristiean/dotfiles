#!/usr/bin/env python3
"""sqlfluff-compact: SQLFluff, plus five layout changes that it has no setting for.

1. AND and OR are indented by 2 under WHERE, so that the conditions line up:

       WHERE a = 1
         AND b = 2

2. The first CTE stands on the line of WITH, and the next ones line up under it:

       WITH first AS (
               SELECT ...),
            second AS (
               SELECT ...)
       SELECT ...

3. The first column stands on the line of SELECT, and the next lines of the
   list line up under it:

       SELECT a, b,
              c
       FROM t

4. In a query, a closing bracket ends the line before it. It does not start a
   line of its own. In other statements, such as CREATE TABLE, it stays on its
   own line.

5. An empty line follows the semicolon that ends a statement.

The script takes the same arguments as sqlfluff:

- `fix ... -` formats the SQL on standard input, then makes the five changes.
- `lint` runs without the rules LT02 and LT07, which would report 1 to 4.
- Every other command goes to sqlfluff unchanged.

In a project that has its own SQLFluff config, every command goes to sqlfluff
unchanged, so that the project's style applies and its checks still pass.

VS Code runs this script through its setting sqlfluff.executablePath.
bin/sql-format runs it for DBeaver.
"""

import configparser
import os
import re
import subprocess
import sys

WHERE = re.compile(r"WHERE\b", re.IGNORECASE)
WITH = re.compile(r"WITH$", re.IGNORECASE)
SELECT = re.compile(r"SELECT( DISTINCT)?$", re.IGNORECASE)
DOLLAR_QUOTE = re.compile(r"\$[A-Za-z_]*\$")
FIRST_WORD = re.compile(r"\s*([A-Za-z]+)")
# The closing brackets that start a line, with the comma or semicolon after them.
CLOSING_BRACKETS = re.compile(r"\s*\)+[,;]?")
# The statements that count as queries: the first word of each.
QUERIES = {"SELECT", "WITH", "INSERT"}

USER_CONFIG = os.path.expanduser("~/.config/sqlfluff/.sqlfluff")

# The files in which a project can keep its SQLFluff config, and the text that
# shows the file has one. None: the file is only for SQLFluff.
PROJECT_CONFIGS = {
    ".sqlfluff": None,
    "pyproject.toml": "[tool.sqlfluff",
    "setup.cfg": "[sqlfluff",
    "tox.ini": "[sqlfluff",
    "pep8.ini": "[sqlfluff",
}


def find_sqlfluff() -> str:
    """Return the path of the real sqlfluff, not of this script."""
    this_script = os.path.realpath(__file__)
    folders = os.environ.get("PATH", "").split(os.pathsep) + ["/opt/homebrew/bin", "/usr/local/bin"]
    for folder in folders:
        candidate = os.path.join(folder, "sqlfluff")
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK) and os.path.realpath(candidate) != this_script:
            return candidate
    sys.exit("sqlfluff-compact: sqlfluff is not installed. Install it with: brew install sqlfluff")


def has_project_config(args: list) -> bool:
    """Say whether the folder of the SQL file, or a folder above it, has a SQLFluff config.

    The search stops at the home folder, where SQLFluff keeps the user's own config.
    """
    folder = os.getcwd()
    if "--stdin-filename" in args[:-1]:
        name = args[args.index("--stdin-filename") + 1]
        folder = os.path.dirname(os.path.abspath(name))
    elif args[-1] != "-" and os.path.exists(args[-1]):
        target = os.path.abspath(args[-1])
        folder = target if os.path.isdir(target) else os.path.dirname(target)
    home = os.path.expanduser("~")
    while folder != home:
        for name, marker in PROJECT_CONFIGS.items():
            path = os.path.join(folder, name)
            if not os.path.isfile(path):
                continue
            if marker is None:
                return True
            with open(path, encoding="utf-8", errors="replace") as config:
                if marker in config.read():
                    return True
        parent = os.path.dirname(folder)
        if parent == folder:
            break
        folder = parent
    return False


def without_layout_rules(args: list) -> list:
    """Return the arguments of `lint` with LT02 and LT07 added to the excluded rules.

    LT02 checks indentation, and LT07 wants the closing bracket of a CTE on a new line.

    --exclude-rules on the command line replaces the list in the config, so the
    list from the user's config goes on the command line too.
    """
    for position, arg in enumerate(args):
        if arg == "--exclude-rules" and position + 1 < len(args):
            return args[: position + 1] + [args[position + 1] + ",LT02,LT07"] + args[position + 2 :]
        if arg.startswith("--exclude-rules="):
            return args[:position] + [arg + ",LT02,LT07"] + args[position + 1 :]
    config = configparser.ConfigParser(interpolation=None)
    config.read(USER_CONFIG)
    excluded = config.get("sqlfluff", "exclude_rules", fallback="")
    rules = ",".join(rule.strip() for rule in excluded.split(",") if rule.strip())
    return args[:1] + ["--exclude-rules", (rules + "," if rules else "") + "LT02,LT07"] + args[1:]


def scan(lines: list) -> tuple:
    """Return two things for each line.

    - Whether it starts in code: not inside a string or a block comment.
    - Its code: the line with every comment and the contents of every string
      replaced by spaces. A bracket or a semicolon in the code is a real one.
    """
    starts_in_code, code = [], []
    inside = None  # None in code, else the mark that ends the string or comment
    for line in lines:
        starts_in_code.append(inside is None)
        kept = []
        position = 0
        while position < len(line):
            char, pair = line[position], line[position : position + 2]
            if inside is None:
                if pair == "--":
                    break
                if pair == "/*":
                    inside, position = "*/", position + 2
                    kept.append("  ")
                    continue
                dollar_quote = DOLLAR_QUOTE.match(line, position)
                if dollar_quote:
                    inside, position = dollar_quote.group(), dollar_quote.end()
                    kept.append(dollar_quote.group())
                    continue
                if char in "'\"`":
                    inside = char
                kept.append(char)
            elif len(inside) > 1:  # a block comment or a dollar-quoted string
                if line.startswith(inside, position):
                    kept.append("  " if inside == "*/" else inside)
                    position += len(inside)
                    inside = None
                    continue
                kept.append(" ")
            elif char == "\\":
                kept.append(" " * len(pair))
                position += 2
                continue
            elif char == inside:
                inside = None
                kept.append(char)
            else:
                kept.append(" ")
            position += 1
        code.append("".join(kept).ljust(len(line)))
    return starts_in_code, code


def indent_of(line: str) -> int:
    return len(line) - len(line.lstrip(" "))


def lines_below(lines: list, in_code: list, number: int) -> list:
    """Return the numbers of the lines that continue line `number`: the ones indented more.

    Empty lines and lines that start inside a string or a block comment are left out.
    """
    base = indent_of(lines[number])
    continuation = []
    for below in range(number + 1, len(lines)):
        if not in_code[below] or not lines[below].strip():
            continue
        if indent_of(lines[below]) <= base:
            break
        continuation.append(below)
    return continuation


def indent_where_by_two(lines: list) -> None:
    """Move the lines that continue each WHERE clause 2 to the left.

    They move only if SQLFluff indented them by 4 or more, so SQL that SQLFluff
    could not format, and returned as it was, stays as it was.
    """
    in_code, _ = scan(lines)
    for number, line in enumerate(lines):
        if not in_code[number] or not WHERE.match(line.lstrip(" ")):
            continue
        continuation = lines_below(lines, in_code, number)
        if continuation and min(indent_of(lines[below]) for below in continuation) >= indent_of(line) + 4:
            for below in continuation:
                lines[below] = lines[below][2:]


def join_first_item(lines: list, keyword: "re.Pattern", only_names: bool) -> None:
    """Put the first item on the line of the keyword, and line the next ones up under it.

    SQLFluff writes the keyword on its own line and the items 4 deeper. The
    lines below the first item move to the right, to the column where the first
    item now starts. With only_names, only the lines that were 4 deeper move:
    the names and closing brackets of CTEs, and not their bodies.
    """
    in_code, _ = scan(lines)
    number = 0
    while number < len(lines):
        line = lines[number]
        if in_code[number] and keyword.match(line.strip(" ")):
            base = indent_of(line)
            continuation = lines_below(lines, in_code, number)
            first = continuation[0] if continuation else None
            if first == number + 1 and indent_of(lines[first]) == base + 4 and not lines[first].lstrip().startswith("--"):
                shift = " " * (len(line.strip(" ")) + 1 - 4)
                for below in continuation[1:]:
                    if not only_names or indent_of(lines[below]) == base + 4:
                        lines[below] = shift + lines[below]
                lines[number] = line + " " + lines[first].lstrip(" ")
                del lines[first], in_code[first]
        number += 1


def statement_kinds(in_code: list, code: list) -> list:
    """Return, for each line, the first word of the statement that the line belongs to."""
    kinds = []
    kind = None
    for starts, text in zip(in_code, code):
        if kind is None and starts:
            word = FIRST_WORD.match(text)
            if word:
                kind = word.group(1).upper()
        kinds.append(kind)
        if text.rstrip().endswith(";"):
            kind = None
    return kinds


def close_brackets_inline(lines: list) -> None:
    """In a query, move a closing bracket that starts a line to the end of the line before it.

    What follows the bracket on its line moves with it, as in `) AS total,`.
    If that text opens a new bracket, as in `), second AS (`, it stays on its line.
    The bracket stays where it is if the line before it ends with a comment,
    because the comment would swallow the bracket.
    """
    in_code, code = scan(lines)
    kinds = statement_kinds(in_code, code)
    number = 1
    while number < len(lines):
        closing = CLOSING_BRACKETS.match(code[number]) if code[number].lstrip().startswith(")") else None
        before = number - 1
        movable = (
            closing
            and in_code[number]
            and kinds[number] in QUERIES
            and code[before].strip()
            and len(code[before].rstrip()) == len(lines[before].rstrip())
        )
        if not movable:
            number += 1
            continue
        rest = code[number][closing.end() :]
        if rest.count("(") > rest.count(")"):
            moved = closing.group().strip()
            lines[before] = lines[before].rstrip() + moved
            lines[number] = " " * indent_of(lines[number]) + lines[number][closing.end() :].lstrip()
            in_code, code = scan(lines)
            number += 1
        else:
            lines[before] = lines[before].rstrip() + lines[number].strip()
            del lines[number]
            in_code, code = scan(lines)
            kinds = statement_kinds(in_code, code)


def separate_statements(lines: list) -> None:
    """Add an empty line after a semicolon that ends a statement.

    The next statement must start at the left margin. This leaves the
    statements inside the body of a procedure together.
    """
    _, code = scan(lines)
    for number in range(len(lines) - 2, -1, -1):
        following = lines[number + 1]
        if code[number].rstrip().endswith(";") and following.strip() and indent_of(following) == 0:
            lines.insert(number + 1, "")


def make_compact(sql: str) -> str:
    lines = sql.split("\n")
    indent_where_by_two(lines)
    join_first_item(lines, WITH, only_names=True)
    join_first_item(lines, SELECT, only_names=False)
    close_brackets_inline(lines)
    separate_statements(lines)
    return "\n".join(lines)


def main() -> None:
    args = sys.argv[1:]
    sqlfluff = find_sqlfluff()
    command = args[0] if args else ""
    fixes_stdin = command == "fix" and len(args) > 1 and args[-1] == "-"
    if not (fixes_stdin or command == "lint") or has_project_config(args):
        os.execv(sqlfluff, [sqlfluff] + args)
    if command == "lint":
        os.execv(sqlfluff, [sqlfluff] + without_layout_rules(args))

    result = subprocess.run([sqlfluff] + args, stdin=sys.stdin.buffer, capture_output=True)
    # surrogateescape passes bytes that are not UTF-8 through unchanged.
    output = make_compact(result.stdout.decode("utf-8", "surrogateescape"))
    sys.stdout.buffer.write(output.encode("utf-8", "surrogateescape"))
    sys.stderr.buffer.write(result.stderr)
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
